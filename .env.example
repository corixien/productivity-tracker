# Database (required - get this from your Neon project dashboard)
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?channel_binding=require&sslmode=require"

# SSL certificate rejection (set to false for Neon self-signed certs; required on Render)
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# JWT secret (set your own key, e.g. from: openssl rand -hex 32)
JWT_SECRET="e2f573ad4f19535aae0056424e7b1044609b32805ed8981ed331a0ae2eb5889c"

# JWT expiration (optional, default: 7d)
# JWT_EXPIRES_IN=7d

# Groq AI (optional - needed for AI task rating)
# GROQ_API_KEY="<your-groq-api-key>"
# GROQ_MODEL="llama-3.1-70b-versatile"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Logging (optional)
# LOG_LEVEL="info"
# LOG_DIR="./logs"

# Server
PORT=3000
NODE_ENV="production"
